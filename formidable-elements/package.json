{
	"name": "formidable-elements",
	"version": "0.5.0",
	"type": "module",
	"files": [
		"dist",
		"src/**/*.cnd",
		"settings",
		"static"
	],
	"scripts": {
		"build": "tsc --noEmit && vitest run && vite build && run package",
		"clean": "rm -rf dist/",
		"deploy": "jahia-deploy",
		"dev": "vite build --watch",
		"format": "prettier --write --list-different .",
		"lint": "eslint .",
		"package": "yarn pack --out dist/package.tgz",
		"watch": "run dev",
		"watch:callback": "run package && run deploy",
		"test": "vitest run"
	},
	"dependencies": {
		"@jahia/formidable-library": "workspace:*",
		"clsx": "^2.1.1"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^1.49.0",
		"@eslint/compat": "^1.2.9",
		"@eslint/js": "^9.26.0",
		"@jahia/javascript-modules-library": "^1.2.0",
		"@jahia/vite-plugin": "^1.2.0",
		"@types/react": "^19.1.2",
		"eslint": "^9.26.0",
		"globals": "^16.0.0",
		"i18next": "^25.5.3",
		"jsdom": "^26.0.0",
		"prettier": "^3.5.3",
		"react": "^19.1.0",
		"react-i18next": "^16.5.4",
		"rollup-plugin-sbom": "^2.1.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.31.1",
		"typescript-plugin-css-modules": "^5.1.0",
		"vite": "7.3.5",
		"vitest": "^3.2.4"
	},
	"packageManager": "yarn@4.12.0",
	"engines": {
		"node": ">=22.0.0",
		"yarn": ">=4.0.0"
	},
	"jahia": {
		"maven": {
			"groupId": "org.jahia.modules.javascript"
		},
		"snapshot": true,
		"module-dependencies": "default,formidable-engine=0.5",
		"module-type": "module",
		"required-version": "8.2.2.0",
		"server": "dist/server/index.js",
		"static-resources": "/dist/client,/dist/assets,/locales,/images,/icons"
	}
}
