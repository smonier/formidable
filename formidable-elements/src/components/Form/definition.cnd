// Message manager component properties
// The response messages share the light editor configuration of the field help
// texts: simple formatting, links and lists — no structural markup in a message.
[fmdbmix:responses] mixin
 - submissionMessage (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) = resourceBundle('submissionMessage.default') autocreated i18n indexed=no
 - errorMessage (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) = resourceBundle('errorMessage.default') autocreated i18n indexed=no
 - maintenanceMessage (string, richtext[ckeditor.toolbar='FormidableHelp',ckeditor.customConfig='$context/modules/formidable-engine/javascript/ckeditor/helpTextConfig.js']) = resourceBundle('maintenanceMessage.default') autocreated i18n indexed=no

[fmdbmix:buttons] mixin
   - submitBtnLabel (string) = resourceBundle('label.submitBtn') autocreated i18n indexed=no
   - showResetBtn (boolean) = false
   - resetBtnLabel (string) = resourceBundle('label.resetBtn') autocreated i18n indexed=no
   - showNewFormBtn (boolean) = false
   - newFormBtnLabel (string) = resourceBundle('label.newFormBtn') autocreated i18n indexed=no
   - showTryAgainBtn (boolean) = false
   - tryAgainBtnLabel (string) = resourceBundle('label.tryAgainBtn') autocreated i18n indexed=no
   - previousBtnLabel (string) = resourceBundle('label.previousBtn') autocreated i18n indexed=no
   - nextBtnLabel (string) = resourceBundle('label.nextBtn') autocreated i18n indexed=no

[fmdbmix:multiStep] mixin
   - showStepsNav (boolean) = true autocreated indexed=no

[fmdbmix:style] mixin
  - css (string,textarea) indexed=no

// Enables CAPTCHA protection on a fmdb:form.
// When this mixin is applied, the form injects the configured CAPTCHA widget (front-end)
// and verifies the submitted token server-side in FormSubmissionPipeline.
// CAPTCHA configuration (siteKey, scriptUrl, verifyUrl, secretKey, etc.) is read from
// org.jahia.modules.formidable.cfg — not stored in JCR.
// Runtime code reads fmdbmix:captchaProtectedForm.
[fmdbmix:captcha] > fmdbmix:captchaProtectedForm mixin
 extends = fmdb:form
 itemtype = content

// Restricts form submission to authenticated users only.
// When this mixin is applied, Guest (anonymous) submissions are rejected server-side
// with FMDB-009 before any file data is read from the request stream.
// Runtime code reads fmdbmix:authenticatedOnlyForm.
[fmdbmix:requireAuthentication] > fmdbmix:authenticatedOnlyForm mixin
 extends = fmdb:form
 itemtype = content

[fmdb:actionList] > jnt:content, jmix:list, mix:title, jmix:systemNameReadonly
 orderable
 - jcr:title (string) = resourceBundle('fmdb_actionList') autocreated i18n
 + * (fmdbmix:formAction) = fmdbmix:formAction version

[fmdb:fieldList] > jnt:content, jmix:list, fmdbmix:formContainer, mix:title, jmix:systemNameReadonly
 orderable
 - jcr:title (string) = resourceBundle('fmdb_fieldList') autocreated i18n
 + * (fmdbmix:formElement) = fmdbmix:formElement
 + * (fmdbmix:formContent) = fmdbmix:formContent
 + * (fmdbmix:formStep) = fmdbmix:formStep

[fmdb:form] > jnt:content, fmdbmix:component, jmix:visibleInContentTree, fmdbmix:buttons, fmdbmix:responses, fmdbmix:multiStep, fmdbmix:style, mix:title, fmdbmix:formRoot
 orderable
 - intro (string, richtext) i18n indexed=no
 + fields (fmdb:fieldList) = fmdb:fieldList autocreated mandatory
 + actions (fmdb:actionList) = fmdb:actionList autocreated mandatory
