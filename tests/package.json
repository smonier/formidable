{
	"name": "formidable-jahia-cypress",
	"version": "0.1.0",
	"scripts": {
		"instrument": "nyc instrument --compact=false cypress instrumented",
		"e2e:ci": "cypress run --browser chrome",
		"playground": "cypress run --browser chrome --config '{\"specPattern\":\"cypress/playground/*.play.ts\",\"responseTimeout\":30000,\"userAgent\":\"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36\"}' --spec cypress/playground/provision-forms.play.ts",
		"playground:maintenance": "cypress run --browser chrome --config \"specPattern=cypress/playground/*.play.ts\" --spec cypress/playground/provision-maintenance-form.play.ts",
		"e2e:debug": "cypress open",
		"lint": "echo 'linting is available at the monorepo root'",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"report:merge": "mochawesome-merge results/reports/mochawesome*.json > results/reports/report.json && rm results/reports/mochawesome*.json",
		"report:html": "marge --inline results/reports/report.json --reportDir results/reports/",
		"build": "tsc -p ./lib-tsconfig.json"
	},
	"license": "MIT",
	"devDependencies": {
		"@4tw/cypress-drag-drop": "^2.3.0",
		"@jahia/cypress": "^8.2.1",
		"@jahia/jahia-reporter": "^2.1.3",
		"@jahia/jcontent-cypress": "^3.6.0-tests.2",
		"@types/cypress": "^1.1.6",
		"@types/node": "^22.14.0",
		"cypress": "^14.5.4",
		"cypress-iframe": "^1.0.1",
		"cypress-multi-reporters": "^2.0.5",
		"cypress-real-events": "^1.15.0",
		"cypress-terminal-report": "^5.3.12",
		"cypress-wait-until": "^3.0.2",
		"graphql": "^15.5.0",
		"graphql-tag": "^2.12.6",
		"mocha": "^10.2.0",
		"mocha-junit-reporter": "^2.2.1",
		"mochawesome": "^7.1.3",
		"mochawesome-merge": "^5.0.0",
		"mochawesome-report-generator": "^6.2.0",
		"typescript": "^5.8.3"
	},
	"packageManager": "yarn@4.12.0"
}
